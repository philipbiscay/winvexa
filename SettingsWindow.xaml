<Window x:Class="Winvexa.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Winvexa"
        Icon="pack://application:,,,/Winvexa;component/winvexa.ico"
        Width="650" Height="560" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="Application status and repair behavior" Foreground="{DynamicResource MutedBrush}"
                 Margin="0,5,0,0" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Liquid Glass" FontWeight="Bold" FontSize="15" />
                <TextBlock Text="Windows Acrylic backdrop blur, translucent layered surfaces, and soft highlights where supported."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,12,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="LiquidGlassToggle" Content="Enable" IsChecked="False"
                          Checked="LiquidGlassToggle_Changed" Unchecked="LiquidGlassToggle_Changed"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10,5">
                  <TextBlock x:Name="LiquidGlassValueText" Text="Liquid Glass: OFF" FontSize="11"
                             FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="LiquidGlassStatusText" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,11,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="System" FontWeight="Bold" FontSize="15" />
            <TextBlock x:Name="WindowsVersionText" Margin="0,9,0,0" />
            <TextBlock x:Name="AdministratorText" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Logs and reports" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Session logs and repair state are stored for the signed-in Windows user."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
            <TextBlock x:Name="LogPathText" TextWrapping="Wrap" Margin="0,8,0,0"
                       FontFamily="Consolas" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18">
          <StackPanel>
            <TextBlock Text="Safety and operation controls" FontWeight="Bold" FontSize="15" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"
                       Text="Winvexa does not delete personal files based on age, disable Defender or Windows Update, or force a restart. Cleanup and system changes require confirmation. Administrator access is requested through normal Windows UAC when needed." />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                       Text="Stop cancels cooperative work and safe-to-stop child processes. System operations without a supported safe cancellation method finish normally before Winvexa returns to idle; no later workflow stage is started." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="2" Content="Close" Width="92" HorizontalAlignment="Right"
            Margin="0,14,0,0" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}"
            Click="Close_Click" />
  </Grid>
</Window>
