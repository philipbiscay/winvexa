<Window x:Class="Winvexa.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Winvexa"
        Icon="pack://application:,,,/Winvexa;component/winvexa.ico"
        Width="700" Height="760" MinWidth="580" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="15" Padding="22" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Winvexa;component/winvexa.ico"
                   Width="58" Height="58" VerticalAlignment="Center" Margin="0,0,18,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="ABOUT THIS PROGRAM" FontSize="11" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Winvexa" FontSize="29" FontWeight="Bold" Margin="0,2,0,0" />
              <TextBlock Text="Windows 11 PC Repair &amp; Maintenance"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                <TextBlock x:Name="VersionText" Text="Version"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="  •  " Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="BuildText" Text="Build"
                           Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <TextBlock Text="Made by Philip Biscay" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="13" Padding="17" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Independent project notice" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="This program is an independent program and is not affiliated with or associated with Microsoft Corporation."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
            <TextBlock Text="Winvexa is not Microsoft Defender, does not provide antivirus protection, and does not replace Microsoft Defender or Windows Security."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="What Winvexa does" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="Winvexa provides Windows 11 diagnostics and guided maintenance, including safe temporary-file cleanup, read-only drive checks, Microsoft Defender integration, Windows cleanup, Windows Update troubleshooting, system-file checks, and optional optimization review. Repairs and cleanup that can change the system require user approval."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Latest features" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="• Optional Liquid Glass theme with remembered ON/OFF preference, Windows Acrylic backdrop blur, translucent surfaces, and a graceful native-backdrop fallback."
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="• Refined Windows-inspired visual system with smoother transitions, clearer hierarchy, and a more responsive dashboard."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Fix My PC: diagnosis-first workflow with relevant, confirmation-gated repairs and follow-up verification."
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="• Windows repair-source preflight checks the installed Windows edition/build, Microsoft Windows Update availability, servicing policy, Microsoft signatures, and component-store state before repair."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Windows Update Loop repair and Verify Windows Update for repeated failures and post-restart checks."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Save Report, dated repair history, and clearer operation status and progress feedback."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Dashboard shortcuts for Defender Quick Scan, diagnostic-only System Health Check, guided repair, results, and logs."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Normal app launch no longer elevates automatically; administrator access is requested only when a selected operation needs it."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Recent fixes" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="• Relocated-build test now launches the active PowerShell host instead of assuming Windows PowerShell's executable name."
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="• Active GUI progress no longer presents estimated percentages as measured completion."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Operation failures retain technical detail in the log and offer an explicit details view."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Repair verification distinguishes attempted actions from changes confirmed by follow-up checks."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Normal window-close requests are deferred while a tracked system operation is running, preserving its final status and report."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• Stop now cancels cooperative work and safely terminates cancellable Winvexa child processes; protected Windows operations finish before the app returns to idle."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
            <TextBlock Text="• DISM RestoreHealth and SFC /scannow are blocked until the current Microsoft repair source is verified; source failures stop the repair before Windows changes are made."
                       TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="13" Padding="18">
          <StackPanel>
            <TextBlock Text="Update information" FontWeight="Bold" FontSize="15" />
            <TextBlock x:Name="ChangelogText" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1" Content="Close" Width="92" HorizontalAlignment="Right"
            Margin="0,14,0,0" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}"
            Click="Close_Click" />
  </Grid>
</Window>
