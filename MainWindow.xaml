<Window x:Class="Winvexa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winvexa"
        Icon="pack://application:,,,/Winvexa;component/winvexa.ico"
        Width="1160" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Closing="MainWindow_Closing">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentGradient}"
                  VerticalAlignment="Center" Margin="0,0,12,0">
            <Image Source="pack://application:,,,/Winvexa;component/winvexa.ico"
                   Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Winvexa" FontSize="25" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock Text="Windows 11 PC Repair &amp; Maintenance" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
              <TextBlock Text="  •  " Foreground="{DynamicResource MutedBrush}" FontSize="12" />
              <TextBlock x:Name="SystemSubtitle" Text="Windows 11" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ViewResultsButton" Content="View Results" Background="Transparent"
                Foreground="{DynamicResource AccentBrush}" Click="ViewResults_Click" />
        <Button x:Name="OpenLogButton" Content="View Logs" Background="Transparent"
                Foreground="{DynamicResource AccentBrush}" Click="OpenLog_Click" />
        <Button x:Name="SettingsButton" Content="Settings" Background="Transparent"
                Foreground="{DynamicResource AccentBrush}" Click="Settings_Click" />
        <Button x:Name="AboutButton" Content="About" Background="Transparent"
                Foreground="{DynamicResource AccentBrush}" Click="About_Click" />
        <Button x:Name="ExitButton" Content="Exit" Background="Transparent"
                Foreground="{DynamicResource AccentBrush}" Click="Exit_Click" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="470" />
        </Grid.ColumnDefinitions>
        <Border Panel.ZIndex="-1" Background="{DynamicResource GlassHighlightBrush}"
                BorderBrush="{DynamicResource GlassHighlightBrush}" BorderThickness="0,1,0,0"
                CornerRadius="15" IsHitTestVisible="False" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Windows Security &amp; System Health" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="A clear view of system health, maintenance, and repair. Microsoft Defender remains your antivirus; Winvexa does not replace or modify its protections."
                     TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,22,0" MaxWidth="520" />
        </StackPanel>
        <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center">
          <Button x:Name="ScanWindowsButton" Content="Scan Windows"
                  ToolTip="Run a diagnostic scan of Windows system files"
                  Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Click="ScanWindows_Click" />
          <Button x:Name="SystemHealthButton" Content="System Health Check"
                  ToolTip="Review system health without applying repairs"
                  Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Click="SystemHealth_Click" />
          <Button x:Name="RepairButton" Content="Repair Windows"
                  ToolTip="Review and run supported Windows repair steps"
                  Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Click="Repair_Click" />
          <Button x:Name="FixMyPcButton" Content="Fix My PC"
                  ToolTip="Diagnose issues first, then review recommended repairs"
                  Background="{DynamicResource AccentGradient}" Foreground="White" Click="FixMyPc_Click" />
          <Button x:Name="ScanButton" Content="Storage Scan" Background="{DynamicResource AccentSoftBrush}"
                  ToolTip="Inspect storage usage without removing files"
                  Foreground="{DynamicResource AccentBrush}" Click="ScanOnly_Click" />
        </UniformGrid>
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,0,0,18">
      <TextBlock Text="Maintenance" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8" />
      <UniformGrid Columns="5">
        <Button x:Name="StorageCleanupButton" Content="Storage Cleanup" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource AccentBrush}"
                Click="StorageCleanup_Click" />
        <Button x:Name="DriveHealthButton" Content="Drive Health" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource AccentBrush}"
                Click="DriveHealth_Click" />
        <Button x:Name="DefenderButton" Content="Antivirus &amp; Security" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource AccentBrush}"
                ToolTip="Review Microsoft Defender status, scans, quarantine, and security events"
                Click="Defender_Click" />
        <Button x:Name="WindowsCleanupButton" Content="Windows Cleanup" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource AccentBrush}"
                Click="WindowsCleanup_Click" />
        <Button x:Name="OptimizationButton" Content="Windows Optimization" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource AccentBrush}"
                Click="Optimization_Click" />
      </UniformGrid>
    </StackPanel>

    <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="15" Padding="20" Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Windows Update" FontWeight="Bold" FontSize="18" />
          <TextBlock Text="Check update health, review available updates, or troubleshoot repeated failures."
                     Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
          <Button x:Name="UpdateButton" Content="Check / Repair" Width="145"
                  Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Click="WindowsUpdate_Click" />
          <Button x:Name="UpdateLoopButton" Content="Fix Windows Update Loop" Width="205"
                  Background="{DynamicResource AccentGradient}" Foreground="White"
                  Click="WindowsUpdateLoop_Click" />
          <Button x:Name="VerifyUpdateButton" Content="Verify Windows Update" Width="190"
                  Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Click="VerifyWindowsUpdate_Click" />
        </StackPanel>
        <Border Grid.Row="2" Background="{DynamicResource SubtleBrush}" CornerRadius="10"
                Padding="12,10" Margin="0,13,0,10">
          <DockPanel LastChildFill="True">
            <Ellipse x:Name="StatusIndicator" Width="9" Height="9" Fill="#738397"
                     VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left" />
            <Button x:Name="StopButton" Content="Stop" DockPanel.Dock="Right"
                    Visibility="Collapsed" IsEnabled="False" MinWidth="82"
                    Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerForegroundBrush}" Click="Stop_Click" />
            <TextBlock x:Name="StatusText" Text="Ready. Choose a scan or maintenance action."
                       TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="3" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ProgressBar x:Name="OperationProgress" Height="8" Minimum="0" Maximum="100"
                       Value="0" VerticalAlignment="Center" />
          <TextBlock x:Name="ProgressText" Grid.Column="1" Text="Ready" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"
                     VerticalAlignment="Center" />
        </Grid>
        <TabControl x:Name="DetailsTabs" Grid.Row="4">
          <TabItem Header="Activity log">
            <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     Background="{DynamicResource SubtleBrush}" BorderThickness="0" Padding="12" />
          </TabItem>
          <TabItem x:Name="FinalReportTab" Header="Results">
            <DockPanel>
              <Button x:Name="SaveReportButton" DockPanel.Dock="Top" Content="Save Report"
                      HorizontalAlignment="Right" Margin="8" Background="{DynamicResource AccentSoftBrush}"
                      Foreground="{DynamicResource AccentBrush}" Click="SaveReport_Click" />
              <TextBox x:Name="ReportText" IsReadOnly="True" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                       Background="{DynamicResource SubtleBrush}" BorderThickness="0" Padding="14" />
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    <TextBlock Grid.Row="4" Text="Made by Philip Biscay  •  Personal files are never selected based on age  •  No forced restart"
               Foreground="{DynamicResource MutedBrush}" FontSize="11" />
  </Grid>
</Window>
