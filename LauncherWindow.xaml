<Window x:Class="Winvexa.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winvexa"
        Icon="pack://application:,,,/Winvexa;component/winvexa.ico"
        Width="420" Height="330" MinWidth="420" MinHeight="330"
        MaxWidth="420" MaxHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Loaded="LauncherWindow_Loaded">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True">
      <Border Width="44" Height="44" CornerRadius="13"
              Background="{DynamicResource AccentGradient}"
              Margin="0,0,12,0">
        <Image Source="pack://application:,,,/Winvexa;component/winvexa.ico"
               Width="34" Height="34"
               ToolTip="Winvexa"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Winvexa" FontSize="23" FontWeight="Bold" />
        <TextBlock Text="Your PC care companion"
                   Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="{DynamicResource HeroGradient}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="16" Padding="16" Margin="0,18,0,16">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="A little care for your PC"
                   FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="Check security, review system health, and find the tools you need — all in one place."
                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                   Margin="0,6,0,12" />
        <DockPanel LastChildFill="True">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusSuccessBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="ReadyStatusText" Text="Starting Winvexa..."
                     FontSize="12" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2">
      <Button x:Name="OpenWinvexaButton" Content="Open Winvexa"
              Background="{DynamicResource AccentGradient}" Foreground="White"
              ToolTip="Open the Winvexa dashboard"
              HorizontalContentAlignment="Center" Click="OpenWinvexa_Click" />
      <DockPanel Margin="0,8,0,0">
        <Button x:Name="ExitButton" Content="Exit" Width="84"
                HorizontalAlignment="Right" Margin="8,0,0,0"
                ToolTip="Close Winvexa"
                Background="Transparent" Foreground="{DynamicResource MutedBrush}"
                Click="Exit_Click" />
        <Button x:Name="SettingsButton" Content="Settings"
                ToolTip="Change Winvexa appearance and review application settings"
                Background="Transparent" Foreground="{DynamicResource AccentBrush}"
                Click="Settings_Click" />
      </DockPanel>
      <TextBlock Text="Made by Philip Biscay" FontSize="10"
                 Foreground="{DynamicResource MutedBrush}"
                 HorizontalAlignment="Center" Margin="0,9,0,0" />
    </StackPanel>
  </Grid>
</Window>
