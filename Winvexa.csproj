<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Winvexa</AssemblyName>
    <RootNamespace>Winvexa</RootNamespace>
    <Product>Winvexa</Product>
    <Company>Winvexa</Company>
    <Authors>Philip Biscay</Authors>
    <AssemblyTitle>Winvexa</AssemblyTitle>
    <Description>Winvexa Windows 11 maintenance and repair utility</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>winvexa.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="winvexa.ico" />
    <EmbeddedResource Include="CHANGELOG.md" />
    <Content Include="ThreatKnowledgeBase.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="tests\ProcessRunner.Tests\**\*.cs" />
  </ItemGroup>
</Project>
