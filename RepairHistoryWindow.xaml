<Window x:Class="Winvexa.RepairHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repair History - Winvexa"
        Icon="pack://application:,,,/Winvexa;component/winvexa.ico"
        Width="1000" Height="680" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Repair History" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="Review dated Winvexa activity logs, including operation results, warnings, and technical errors."
                 Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent"
                 SelectionChanged="HistoryList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,6">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,3,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="1" Background="{DynamicResource SubtleBrush}" CornerRadius="10" Margin="12,0,0,0">
          <TextBox x:Name="LogContentText" IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                   BorderThickness="0" />
        </Border>
      </Grid>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="HistoryStatusText" Foreground="{DynamicResource MutedBrush}"
                 VerticalAlignment="Center" />
      <Button Content="Close" Width="92" HorizontalAlignment="Right"
              Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" Click="Close_Click" />
    </DockPanel>
  </Grid>
</Window>
