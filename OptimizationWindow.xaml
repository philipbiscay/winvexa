<Window x:Class="Winvexa.OptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 11 Optimization"
        Icon="pack://application:,,,/Winvexa;component/winvexa.ico"
        Width="1050" Height="760" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Closing="OptimizationWindow_Closing">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="150" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Windows 11 Optimization" FontSize="26" FontWeight="Bold" />
      <TextBlock Text="Scan first, review each proposed change, and choose only what you want. Winvexa never disables services or applies a bulk debloat."
                 TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <Button x:Name="ScanButton" Content="Scan for Optimizations" Click="Scan_Click"
              ToolTip="Review optional settings recommendations without applying changes"
              Background="{DynamicResource AccentGradient}" Foreground="White" />
      <Button x:Name="UndoButton" Content="Undo Previous Optimization" Click="Undo_Click"
              ToolTip="Review and undo the last Winvexa optimization change"
              Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock x:Name="UndoSummaryText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                 TextWrapping="Wrap" />
    </DockPanel>

    <ProgressBar x:Name="OperationProgress" Grid.Row="2" Height="6" Margin="0,0,0,10"
                 IsIndeterminate="False" Visibility="Collapsed" />

    <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="13">
      <TextBox x:Name="ReportText" IsReadOnly="True" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"
               Background="Transparent" BorderThickness="0" Padding="12" />
    </Border>

    <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,12,0,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="RecommendationsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,11">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding Selectable}"
                          VerticalContentAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentAndProposed}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="#344054" />
                    <TextBlock Text="{Binding Description}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="5" LastChildFill="True">
      <Button x:Name="StopButton" Content="Stop" Click="Stop_Click"
              Background="{DynamicResource DangerBackgroundBrush}" Foreground="{DynamicResource DangerForegroundBrush}"
              Visibility="Collapsed" IsEnabled="False" />
      <Button x:Name="ApplyButton" Content="Review / Apply Selected Changes" Click="Apply_Click"
              Background="{DynamicResource AccentGradient}" Foreground="White" />
      <Button x:Name="SettingsButton" Content="Open Selected Windows Settings" Click="OpenSettings_Click"
              Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" />
      <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentBrush}" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                 Text="Choose Scan for Optimizations to begin." TextWrapping="Wrap" />
    </DockPanel>
  </Grid>
</Window>
